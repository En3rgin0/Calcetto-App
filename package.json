{
  "name": "calcetto-club",
  "private": true,
  "description": "Il registro dei vostri calcetti: statistiche, carte e overall da 64 a 99.",
  "scripts": {
    "start": "npx --yes serve@14 calcetto -l 8000",
    "test": "node --test tests/stats.test.mjs tests/teams.test.mjs",
    "test:rules": "firebase emulators:exec --project demo-calcetto --only firestore \"node tests/firestore.rules.test.mjs\"",
    "deploy:rules": "firebase deploy --only firestore:rules"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "firebase": "^10.14.1",
    "firebase-tools": "^13.35.1"
  }
}
